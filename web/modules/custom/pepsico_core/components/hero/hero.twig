{#
/**
 * @file
 * Hero banner component.
 *
 * Props: headline, subheadline, cta_label, cta_url, image_url.
 * The headline is a paragraph, not a heading, so each page keeps one h1.
 */
#}
<section class="pn-hero" aria-label="{{ 'Newsroom introduction'|t }}">
  {% if image_url %}
    <img class="pn-hero__image" src="{{ image_url }}" alt="" loading="eager">
  {% endif %}
  <div class="pn-container pn-hero__inner">
    <p class="pn-hero__headline">{{ headline }}</p>
    {% if subheadline %}
      <p class="pn-hero__subheadline">{{ subheadline }}</p>
    {% endif %}
    {% if cta_label and cta_url %}
      <a class="pn-hero__cta" href="{{ cta_url }}">{{ cta_label }}</a>
    {% endif %}
  </div>
</section>
