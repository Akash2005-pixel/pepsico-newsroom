/web/.ht.router.php
/web/example.gitignore
/web/INSTALL.txt
/web/README.md
/web/sites/default/files/
/web/sites/default/settings.ddev.php
/web/sites/default/default.*.yml
/web/sites/default/default.settings.php
.env

# OAuth2 keys and client secrets (per environment, never committed)
/keys/
*.key
*.pem
/.oauth-client*
